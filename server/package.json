{
  "name": "nogotochki-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:dev": "node src/db/seed-dev.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "db:dev": "node src/db/migrate.js && node src/db/seed-dev.js",
    "db:reset": "node src/db/reset.js",
    "db:schema": "node src/db/inspect.js",
    "start": "node src/http/index.js",
    "dev": "node --watch src/http/index.js",
    "test": "node --test --test-concurrency=1 src/domain/availability.test.js src/domain/overlap.test.js src/http/api.test.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1"
  }
}
