# SQLite через встроенный node:sqlite. Native-модуль (better-sqlite3) не используется.
# Нужен Node.js 22.16+ или 24. На BeGet поставьте эту версию в панели или через nvm.

# Путь к файлу SQLite. Относительный путь считается от корня репозитория.
# Если пусто, используется data/nogotochki.sqlite
DATABASE_PATH=

# Окружение: development | production
NODE_ENV=

# Порт HTTP-сервера. В этом срезе не используется, зарезервирован на потом.
PORT=
