# SQLite через встроенный node:sqlite. Native-модуль (better-sqlite3) не используется.
# Нужен Node.js 22.16+ или 24. На BeGet поставьте эту версию в панели или через nvm.

# Путь к файлу SQLite. Относительный путь считается от корня репозитория.
# Если пусто, используется data/nogotochki.sqlite
DATABASE_PATH=

# Окружение: development | production
NODE_ENV=

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Разрешённый Origin для CORS. Пусто — отражать Origin запроса.
# Для cookie с фронта укажите точный origin, например http://localhost:3000
CORS_ORIGIN=

# Срок жизни сессии в днях (по умолчанию 30)
SESSION_DAYS=30

# Почты администраторов через запятую. Колонки role в схеме нет.
# По умолчанию admin@nogotochki.test из seed:dev
ADMIN_EMAILS=admin@nogotochki.test
