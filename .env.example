# SQLite через встроенный node:sqlite. Native-модуль (better-sqlite3) не используется.
# Нужен Node.js 22.16+ или 24. На BeGet поставьте эту версию в панели или через nvm.

# Путь к файлу SQLite. Относительный путь считается от корня репозитория.
# Если пусто, используется data/nogotochki.sqlite
DATABASE_PATH=

# Окружение: development | production
NODE_ENV=

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Разрешённый Origin для CORS. Пусто — отражать Origin запроса.
# Для cookie с фронта укажите точный origin, например http://localhost:3000
CORS_ORIGIN=

# Срок жизни сессии в днях (по умолчанию 30)
SESSION_DAYS=30

# Сколько ближайших прокси доверять для IP (лимит входа и регистрации).
# Пусто / 0 — только адрес сокета (локально и если Node доступен напрямую).
# 1 — на BeGet, когда nginx терминирует TLS и прописывает клиентский IP.
# Без 1 за прокси все клиенты попадут в одно ведро 127.0.0.1.
TRUST_PROXY=

# Пароли только для `npm run seed:dev`. В БД пишется salted scrypt, не этот текст.
# Не используйте эти значения на production. Авторизация ролей — таблица client_roles, не список email.
DEV_ADMIN_PASSWORD=DevAdmin123!
DEV_MASTER_PASSWORD=DevMaster123!
DEV_CLIENT_PASSWORD=DevClient123!

# --- Вход через Яндекс (временная заглушка) ---
# НЕ включайте на BeGet / production. Только локальная проверка до публикации сервиса
# и регистрации приложения в Яндексе. По умолчанию выкл.
# Когда включено (1/true/on), POST /api/auth/yandex не ходит в Яндекс,
# а подставляет почту и имя ниже.
YANDEX_OAUTH_STUB=0
YANDEX_STUB_EMAIL=yandex-stub@nogotochki.test
YANDEX_STUB_NAME=Яндекс Тест
YANDEX_STUB_PROVIDER_ID=yandex-stub-1
